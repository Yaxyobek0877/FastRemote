[Unit]
Description=FastRemote persistent terminal server
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
RuntimeDirectory=fastremote
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/disk1/test_project/FastRemote/deploy/terminal-server.sh /disk1/test_project/FastRemote/deploy/terminal.tmux.conf %t/fastremote/tmux.sock
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=default.target
